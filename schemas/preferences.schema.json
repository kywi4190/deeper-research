        "mild",
        "moderate",
        "strong"
      ],
      "title": "PreferenceStrength",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Tastes only: interests, aesthetics, risk appetite, soft dislikes.\nQUARANTINED \u2014 readable only by the screener and synthesist, enforced by a\nPreToolUse hook, not prompt goodwill (design \u00a76).",
  "properties": {
    "items": {
